"""Variant registry for the launder-detection matrix.

EVERY variant records the EXACT argv template that produces it. The previous
matrix's "lame-v0" is unusable because its command line was not preserved;
that must never happen again, so `argv` here IS the record.

Placeholders: {in} = the PCM WAV, {out} = the lossy intermediate.

kind:
  genuine      - no build at all; measurement points at the source album dir.
  null         - FLAC -> WAV -> FLAC, no lossy step (the confound control).
  local        - run `argv` on doc1.
  remote_qaac  - ship the WAV to the Windows VM, run qaac, ship back.

Chain for every non-genuine variant:
  source FLAC --WAV_ARGV--> PCM WAV (native rate/depth, NO resample)
              --argv-------> lossy intermediate   (skipped for kind=null)
              --DECODE_ARGV-> 16-bit FLAC
"""
from __future__ import annotations

# FLAC -> PCM WAV. {codec} is pcm_s16le / pcm_s24le, chosen from the source's
# bit depth. No -ar: 44.1 kHz sources stay 44.1 kHz.
WAV_ARGV = [
    "ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", "{in}",
    "-map", "0:a", "-map_metadata", "-1", "-vn", "-c:a", "{codec}",
    "-f", "wav", "{out}",
]

# lossy (or WAV, for kind=null) -> 16-bit FLAC. 16-bit is the adversarial
# case: a 24-bit twin measured up to +13.8 dB higher U on the Apple arm
# because requantisation noise refills the ultrasonic band.
DECODE_ARGV = [
    "ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", "{in}",
    "-map", "0:a", "-map_metadata", "-1", "-vn",
    "-sample_fmt", "s16", "-c:a", "flac", "{out}",
]

_FF = ["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", "{in}",
       "-map", "0:a", "-map_metadata", "-1", "-vn"]


def _ffmpeg(codec: str, *args: str) -> list[str]:
    return _FF + ["-c:a", codec, *args, "{out}"]


# id -> spec. `codec_family` mirrors what lib.spectral_check would call the
# lossy intermediate; `encoder`/`setting` fill columns 3/4 of the committed
# results TSV.
VARIANTS: dict[str, dict[str, object]] = {
    # ---- controls ----
    "genuine": {
        "kind": "genuine", "ext": "flac", "codec_family": "lossless",
        "encoder": "-", "setting": "-", "argv": [],
        "notes": "untouched source FLAC from the beets library",
    },
    "null-flac": {
        "kind": "null", "ext": "wav", "codec_family": "lossless",
        "encoder": "ffmpeg", "setting": "wav-roundtrip", "argv": [],
        "notes": "FLAC -> WAV -> FLAC, NO lossy step. If this moves the gate "
                 "statistic away from genuine, every matrix result is confounded.",
    },

    # ---- MP3: the real lame binary ----
    "lame-v0": {
        "kind": "local", "ext": "mp3", "codec_family": "mp3",
        "encoder": "lame", "setting": "-V0",
        "argv": ["lame", "--quiet", "--noreplaygain", "-V", "0", "{in}", "{out}"],
        "notes": "stock lame -V0; lowpass left at lame's default (~19.5 kHz)",
    },
    "lame-v2": {
        "kind": "local", "ext": "mp3", "codec_family": "mp3",
