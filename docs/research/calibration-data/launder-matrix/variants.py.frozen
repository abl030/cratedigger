PILOT = ["genuine", "null-flac", "lame-v0", "ffmpeg-q0", "aacffm-256",
         "vorbis-q6", "opus-128", "lame-cbr128"]


def spec(vid: str) -> dict[str, object]:
    if vid not in VARIANTS:
        raise KeyError(f"unknown variant {vid!r}; known: {sorted(VARIANTS)}")
    return VARIANTS[vid]
