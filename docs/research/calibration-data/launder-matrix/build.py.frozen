"""Build launder variants: source FLAC -> WAV -> encoder -> 16-bit FLAC.

Idempotent and resumable. Per (variant, album) the index records `done`, the
EXACT argv templates, one fully-rendered example command, and the encoder
version string captured at build time.

  python3 build.py --variants lame-v0,opus-128 [--albums 8918,8923,8933]

Intermediates (WAV + lossy) stage on doc1 local disk and are deleted per
album; only the final FLACs land on the shared virtiofs tree.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
from variants import DECODE_ARGV, WAV_ARGV, spec  # noqa: E402

OUT_ROOT = "/mnt/virtio/Music/matrix"
STAGE = os.path.join(HERE, "stage")
MANIFEST = os.path.join(HERE, "manifest.json")
WIN = "192.168.1.115"
WINDIR = "C:\\matrix"


def run(cmd, **kw):
    r = subprocess.run(cmd, capture_output=True, text=True,
                       errors="replace", **kw)
    if r.returncode != 0:
        raise RuntimeError(f"rc={r.returncode}: {' '.join(map(str, cmd))[:300]}\n"
                           f"{r.stderr[-700:]}")
    return r


def ssh(script):
    return run(["env", "-u", "SSH_AUTH_SOCK", "ssh", "-o", "ConnectTimeout=20",
                WIN, script])


def render(tmpl, **kw):
    return [p.format(**kw) for p in tmpl]


def encoder_version(vid, sp):
    kind = sp["kind"]
    try:
        if kind == "remote_qaac":
            r = ssh(f'& "{sp["argv"][0]}" --check 2>&1 | Select-Object -First 1')
            return r.stdout.strip().splitlines()[0] if r.stdout.strip() else "?"
        if kind in ("null", "genuine") or sp["argv"][0] == "ffmpeg":
            r = subprocess.run(["ffmpeg", "-version"], capture_output=True, text=True)
            return r.stdout.splitlines()[0]
        r = subprocess.run([sp["argv"][0], "--version"], capture_output=True, text=True)
        return (r.stdout or r.stderr).splitlines()[0]
    except Exception as e:  # noqa: BLE001 - recorded, not fatal
        return f"<unavailable: {e}>"


def _wav(job):
    codec = "pcm_s24le" if str(job["bits"]) == "24" else "pcm_s16le"
    run(render(WAV_ARGV, **{"in": job["src"], "out": job["wav"], "codec": codec}))


def _enc_local(job):
    run(render(job["argv"], **{"in": job["wav"], "out": job["enc"]}))


def _flac(job):
    run(render(DECODE_ARGV, **{"in": job["dec_in"], "out": job["flac"]}))


def probe_out(path):
    r = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "a:0", "-show_entries",
         "stream=sample_rate,channels,bits_per_raw_sample", "-of", "json", path],
        capture_output=True, text=True, check=True)
    st = json.loads(r.stdout)["streams"][0]
    return int(st.get("sample_rate", 0)), int(st.get("channels", 0))


def build_album(vid, sp, album, workers):
    rid = str(album["request_id"])
    vroot = os.path.join(OUT_ROOT, vid)
    adir = os.path.join(vroot, rid)
    sdir = os.path.join(STAGE, vid, rid)
    os.makedirs(adir, exist_ok=True)
    os.makedirs(sdir, exist_ok=True)
    kind, ext = sp["kind"], sp["ext"]
    t0 = time.time()

    jobs = []
    for i, t in enumerate(album["tracks"]):
        base = f"{i:03d}"
        j = {"src": t["path"], "base": base, "sr": t["sr"], "bits": t["bits"],
             "wav": os.path.join(sdir, base + ".wav"),
             "enc": os.path.join(sdir, base + "." + ext),
             "flac": os.path.join(adir, base + ".flac"),
             "argv": sp["argv"]}
        j["dec_in"] = j["wav"] if kind == "null" else j["enc"]
        jobs.append(j)

    with ThreadPoolExecutor(max_workers=workers) as ex:
        list(ex.map(_wav, jobs))
    t1 = time.time()

    if kind == "local":
        with ThreadPoolExecutor(max_workers=workers) as ex:
            list(ex.map(_enc_local, jobs))
    elif kind == "remote_qaac":
        rd = f"{WINDIR}\\{vid}-{rid}"
        ssh(f'Remove-Item -Recurse -Force {rd} -EA SilentlyContinue; '
            f'New-Item -ItemType Directory -Force {rd} | Out-Null')
        run(["env", "-u", "SSH_AUTH_SOCK", "scp", "-q", "-r", sdir + "/.",
             f"{WIN}:{rd.replace(chr(92), '/')}/"])
        a = sp["argv"]
        flags = " ".join(f'"{x}"' for x in a[1:a.index("-o")])
        enc = ssh(f'Get-ChildItem {rd}\\*.wav | ForEach-Object {{ & "{a[0]}" '
                  f'{flags} -o ($_.FullName -replace "\\.wav$",".{ext}") '
                  f'$_.FullName ; "DONE " + $_.Name + " rc=" + $LASTEXITCODE }}')
        ok = [x for x in enc.stdout.splitlines()
              if x.startswith("DONE ") and x.endswith("rc=0")]
        if len(ok) != len(jobs):
            raise RuntimeError(f"[{vid}/{rid}] encode {len(ok)}/{len(jobs)}:"
                               f"\n{enc.stdout[-800:]}")
        run(["env", "-u", "SSH_AUTH_SOCK", "scp", "-q",
             f"{WIN}:{rd.replace(chr(92), '/')}/*.{ext}", sdir + "/"])
        ssh(f'Remove-Item -Recurse -Force {rd} -EA SilentlyContinue')
    elif kind != "null":
        raise RuntimeError(f"unbuildable kind {kind}")
    t2 = time.time()

    with ThreadPoolExecutor(max_workers=workers) as ex:
        list(ex.map(_flac, jobs))
    t3 = time.time()

    rendered = render(sp["argv"], **{"in": jobs[0]["wav"], "out": jobs[0]["enc"]}) \
        if sp["argv"] else []
    out_sr, out_ch = probe_out(jobs[0]["flac"])

    for j in jobs:
        for p in (j["wav"], j["enc"]):
            if os.path.exists(p):
                os.remove(p)
    os.rmdir(sdir)

    rec = {
        "done": True, "album_dir": album["album_dir"], "n": len(jobs),
        "out_sample_rate": out_sr, "out_channels": out_ch,
        "src_sample_rate": jobs[0]["sr"], "src_bits": jobs[0]["bits"],
        "example_encode_argv": rendered,
        "seconds": {"wav": round(t1 - t0, 1), "encode": round(t2 - t1, 1),
                    "flac": round(t3 - t2, 1), "total": round(t3 - t0, 1)},
        "map": [{"genuine": j["src"], "launder": j["flac"]} for j in jobs],
    }
    return rec


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--variants", required=True)
    ap.add_argument("--albums", default="")
    ap.add_argument("--workers", type=int, default=4)
    a = ap.parse_args()

    albums = json.load(open(MANIFEST))
    only = {x.strip() for x in a.albums.split(",") if x.strip()}
    if only:
        albums = [x for x in albums if str(x["request_id"]) in only]
    os.makedirs(STAGE, exist_ok=True)

    for vid in [v.strip() for v in a.variants.split(",") if v.strip()]:
        sp = spec(vid)
        if sp["kind"] == "genuine":
            print(f"[{vid}] control - nothing to build", flush=True)
            continue
        vroot = os.path.join(OUT_ROOT, vid)
        os.makedirs(vroot, exist_ok=True)
        ipath = os.path.join(vroot, "index.json")
        index = json.load(open(ipath)) if os.path.exists(ipath) else {}
        index.setdefault("_variant", {})
        index["_variant"] = {
            "id": vid, **{k: sp[k] for k in
                          ("kind", "ext", "codec_family", "encoder", "setting", "notes")},
            "encode_argv_template": sp["argv"],
            "wav_argv_template": WAV_ARGV,
            "decode_argv_template": DECODE_ARGV,
            "encoder_version": encoder_version(vid, sp),
        }
        for alb in albums:
            rid = str(alb["request_id"])
            if index.get(rid, {}).get("done"):
                print(f"[{vid}/{rid}] already done", flush=True)
                continue
            rec = build_album(vid, sp, alb, a.workers)
            index[rid] = rec
            json.dump(index, open(ipath, "w"), indent=1)
            s = rec["seconds"]
            print(f"[{vid}/{rid}] {rec['n']}tr wav={s['wav']:.0f}s enc={s['encode']:.0f}s "
                  f"flac={s['flac']:.0f}s tot={s['total']:.0f}s out_sr={rec['out_sample_rate']}",
                  flush=True)
        json.dump(index, open(ipath, "w"), indent=1)


if __name__ == "__main__":
    main()
