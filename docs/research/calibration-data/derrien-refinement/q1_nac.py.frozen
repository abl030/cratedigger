from engine import *

C = build()
GEN = "gt:genuine"
LAU = "gt:gtarm-qaac-cvbr256"
A = ALB15

g = [t for a in A for t in C[GEN].get(a, [])]
l = [t for a in A for t in C[LAU].get(a, [])]
print(f"paired arm, 15 albums: genuine n={len(g)}  Apple CVBR-256 launder n={len(l)}")
print(f"NAC populated: genuine {sum(t.nac_z is not None for t in g)}  launder {sum(t.nac_z is not None for t in l)}")


def desc(name, vals):
    v = sorted(x for x in vals if x is not None)
    if not v:
        return f"{name:12s} (empty)"
    q = lambda p: v[min(len(v) - 1, int(round(p * (len(v) - 1))))]
    return (f"{name:12s} n={len(v):4d} min={v[0]:9.4f} q25={q(.25):9.4f} med={q(.5):9.4f} "
            f"q75={q(.75):9.4f} q95={q(.95):9.4f} max={v[-1]:9.4f}")


print("\n--- TRACK-LEVEL DISTRIBUTIONS (paired arm) ---")
for nm, f in (("proba", sc_proba), ("z", sc_z), ("nac_z", sc_nac)):
    print(" GEN ", desc(nm, [f(t) for t in g]))
    print(" LAU ", desc(nm, [f(t) for t in l]))


def auc(pos, neg):
    """Mann-Whitney AUC: P(pos > neg) + 0.5 P(tie)."""
    pos = [x for x in pos if x is not None]
    neg = [x for x in neg if x is not None]
    if not pos or not neg:
        return float("nan")
    allv = sorted([(x, 1) for x in pos] + [(x, 0) for x in neg])
    # rank with ties
    ranks = {}
    i = 0
    r = [0.0] * len(allv)
    while i < len(allv):
        j = i
        while j + 1 < len(allv) and allv[j + 1][0] == allv[i][0]:
            j += 1
        avg = (i + j) / 2.0 + 1
        for k in range(i, j + 1):
            r[k] = avg
        i = j + 1
    sp = sum(r[k] for k in range(len(allv)) if allv[k][1] == 1)
    n1, n0 = len(pos), len(neg)
    return (sp - n1 * (n1 + 1) / 2.0) / (n1 * n0)


print("\n--- TRACK-LEVEL AUC (launder = positive) ---")
for nm, f in (("proba", sc_proba), ("z", sc_z), ("nac_z", sc_nac),
              ("proba*z", sc_pz), ("proba/median", sc_ratio)):
    print(f"  {nm:14s} AUC={auc([f(t) for t in l], [f(t) for t in g]):.4f}")

# combinations of nac_z with the main statistics
print("\n--- COMBINED SCORES (track AUC) ---")


def mk(fn, name):
    fn.__name__ = name
    return fn


combos = [
    ("nac_z*z", lambda t: t.nac_z * t.z if t.nac_z is not None else None),
    ("nac_z*proba", lambda t: t.nac_z * t.proba if t.nac_z is not None else None),
    ("nac_z+z", lambda t: t.nac_z + t.z if t.nac_z is not None else None),
    ("min(nac_z,z)", lambda t: min(t.nac_z, t.z) if t.nac_z is not None else None),
    ("z/nac_z", lambda t: t.z / t.nac_z if t.nac_z else None),
]
for nm, f in combos:
    print(f"  {nm:14s} AUC={auc([f(t) for t in l], [f(t) for t in g]):.4f}")

