"""Q2: what floor can a WALL (ceiling-leg) signature support? LOO by album."""
import json, bisect
from collections import defaultdict
from statistics import median
F=json.load(open('/home/abl030/.claude/jobs/fb229c18/tmp/floor/feats.json'))
Q=json.load(open('/home/abl030/.claude/jobs/fb229c18/tmp/floor/q2feats.json'))
KB={(r['ds'],r['slug'],r['variant']):r['kbps'] for r in Q}
LOSSLESS=10000
def wall(r): return r['step']>=15.0 and r['cons']>=0.5 and r['cliff_frac']<0.6
for tag,dss in (('ARMS',{'TRAIN','R1','R2','R3'}),('MATRIX19',{'LOCAL','LOCALW','APPLE'})):
    pool=[]
    for r in F:
        if r['ds'] not in dss: continue
        k=KB.get((r['ds'],r['slug'],r['variant']))
        if k is None or not wall(r): continue
        pool.append((r,k))
    if not pool: continue
    # statistic: step magnitude (bigger wall = harder lowpass = lower bitrate)  -> floor = min kbps over rows with step <= s
    res=[]
    for a in sorted({(r['ds'],r['slug']) for r,_ in pool}):
        tr=[(r,k) for r,k in pool if (r['ds'],r['slug'])!=a]
        pts=sorted((r['step'],k) for r,k in tr); xs=[];mins=[];m=10**9
        for x,k in pts: m=min(m,k); xs.append(x); mins.append(m)
        # F(s) = min kbps over rows with step <= s   (a SMALLER wall implies a HIGHER floor)
        def Ff(s):
            i=bisect.bisect_right(xs,s)-1
            return mins[i] if i>=0 else LOSSLESS
        for r,k in ((r,k) for r,k in pool if (r['ds'],r['slug'])==a): res.append((r,k,Ff(r['step'])))
    ok=sum(1 for _r,k,f in res if k>=f)
    print(f"\n=== {tag}: floor from a WALL signature (ceiling leg, no cliff). n={len(res)} candidates; LOO by album ===")
    print(f"    correctness {ok}/{len(res)} = {100*ok/len(res):.1f}%   median floor {median(f for _r,_k,f in res):.0f}")
    byv=defaultdict(list)
    for r,k,f in res: byv[r['variant']].append((f,k))
    for v in sorted(byv,key=lambda v: byv[v][0][1]):
        fs=sorted(f for f,_ in byv[v])
        if len(fs)<3: continue
        print(f"    {v:<18}true {('LL' if byv[v][0][1]==LOSSLESS else byv[v][0][1]):>6}  n={len(fs):<4} floor med {median(fs):>6.0f}  min {min(fs):>5}  viol {sum(1 for f,k in byv[v] if k<f)}")
