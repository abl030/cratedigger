                 "U_sd", "d18_195_sd", "rat_mpdhi_over_mpdlo"):
        operating(stat)
    operating("U_sd", hi=False)
    operating("shape_mpd_ul", hi=False)
    try:
        multivariate_ceiling()
    except ImportError as e:
        print("sklearn unavailable:", e)
